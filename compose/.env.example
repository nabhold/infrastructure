# Development-only values. Copy this file to compose/.env and replace every
# value before starting the topology. compose/.env is ignored by Git.

COMPOSE_PROJECT_NAME=nabhold-platform

APISIX_ADMIN_KEY=replace-with-at-least-32-random-characters
APISIX_HTTP_PORT=9080
APISIX_ADMIN_PORT=9180

POSTGRES_DB=baobab_control
POSTGRES_USER=baobab_control
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=baobab_control
RABBITMQ_DEFAULT_PASS=replace-with-a-random-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=nabhold
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_PORT=6379

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

